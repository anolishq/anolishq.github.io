{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>anolishq/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the release each source repository's docs are published from",
      "managerFilePatterns": [
        "/^data/repos\\.json$/"
      ],
      "matchStrings": [
        "\"repo\":\\s*\"(?<depName>[^\"]+)\",\\s*\"ref\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Group docs source pin updates into a single PR",
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "docs source pins",
      "commitMessagePrefix": "deps:",
      "semanticCommitType": "deps"
    }
  ]
}
